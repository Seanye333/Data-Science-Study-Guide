{
  "theme_init": "<script>(function(){if(localStorage.getItem('ds_theme')==='light'){document.addEventListener('DOMContentLoaded',function(){document.body.classList.add('light-mode');var b=document.getElementById('theme-toggle');if(b)b.textContent='☀️';});}})();</script>",
  "loader": "<div id=\"page-loader\">\n  <div class=\"loader-logo\">📖</div>\n  <div class=\"loader-bar-wrap\"><div class=\"loader-bar\"></div></div>\n  <div class=\"loader-text\">Loading Module…</div>\n</div>",
  "footer": "<div class=\"mob-overlay\" id=\"mob-overlay\"></div>\n<button class=\"mob-menu-btn\" id=\"mob-menu-btn\" aria-label=\"Open menu\">&#9776;</button>\n<script>\n(function(){\n  var btn     = document.getElementById('mob-menu-btn');\n  var overlay = document.getElementById('mob-overlay');\n  var sidebar = document.querySelector('.page-module .sidebar') ||\n                document.querySelector('.page-module > nav') ||\n                document.querySelector('.page-module #sidebar');\n  if (!btn || !sidebar) return;\n\n  function open() {\n    sidebar.classList.add('mob-open');\n    overlay.classList.add('active');\n    document.body.classList.add('mob-sidebar-open');\n    btn.innerHTML = '&#10005;';\n  }\n  function close() {\n    sidebar.classList.remove('mob-open');\n    overlay.classList.remove('active');\n    document.body.classList.remove('mob-sidebar-open');\n    btn.innerHTML = '&#9776;';\n  }\n\n  btn.addEventListener('click', function() {\n    sidebar.classList.contains('mob-open') ? close() : open();\n  });\n  overlay.addEventListener('click', close);\n\n  // Close when a nav link is clicked\n  sidebar.querySelectorAll('a').forEach(function(a){\n    a.addEventListener('click', function(){ if(window.innerWidth <= 700) close(); });\n  });\n})();\n</script>\n<script src=\"../../styles/effects.js\"></script>\n<script src=\"../../styles/nav-ux.js\"></script>\n<script src=\"../../styles/hands-on.js\"></script>\n<button class=\"theme-toggle\" id=\"theme-toggle\" title=\"Toggle light/dark mode\"\n  style=\"position:fixed;top:14px;right:14px;z-index:100;\">🌙</button>"
}
